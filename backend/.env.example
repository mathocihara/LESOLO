APP_NAME=LESOLO
APP_ENV=development
DEBUG=true
API_HOST=127.0.0.1
API_PORT=8000
FRONTEND_URL=http://localhost:5173

# Provedor local de explicações. A IA interpreta os resultados existentes;
# ela não participa do processamento geoespacial.
OLLAMA_URL=http://localhost:11434/api/chat
OLLAMA_MODEL=llama3.2:3b
OLLAMA_CONTEXT_LENGTH=8192
OLLAMA_NUM_PREDICT=768
OLLAMA_TIMEOUT_SECONDS=180
IA_MAX_VALIDATION_ATTEMPTS=1
IA_MAX_REFERENCIAS_CONTEXTO=1
